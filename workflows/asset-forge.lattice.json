        "outputKind": "text",
        "template": "Subject: {{data:/label}} ({{data:/id}})\nWorld Context: {{data:/world_look/setting}}\nHost Zone Backpressure: {{data:/zone_context/zone_name}} ({{data:/zone_context/substrate_material}})\nEpistemic Standing: {{data:/standing_tier}} (saturation: {{data:/saturation_score}})\nPhysicality: {{data:/physical_specs}}\nMaterial Construction: {{data:/world_look/materials}}\n\nAdmitted Lore Fragments:\n{{data:/fragments_summary}}",
