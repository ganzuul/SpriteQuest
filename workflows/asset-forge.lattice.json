        "profileId": null,
        "model": null,
        "modelRole": null,
        "alias": "Compose · Flux 3 Klein Graph Parameters",
        "mode": "template",
        "outputKind": "text",
        "template": "{\n  \"prompt\": \"{{prompt}}\",\n  \"negative\": \"ugly, blurry, low quality, artifacts, watermark, photographic background, cutoff silhouette\",\n  \"steps\": 8,\n  \"cfg\": 1.0,\n  \"sampler\": \"euler\",\n  \"scheduler\": \"simple\",\n  \"dimensions\": [1024, 1024]\n}",
        "sections": [],
        "separator": "\n\n",
