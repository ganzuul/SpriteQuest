        "alias": "Compose · Fragment & World Specification",
        "mode": "template",
        "outputKind": "text",
        "template": "Subject: {{label}} ({{id}})\nWorld Context: {{world_look.setting}}\nPhysicality: {{physical_specs}}\nMaterial Construction: {{world_look.materials}}\n\nActive Lore Fragments:\n{{fragments_summary}}",
        "sections": [],
        "separator": "\n\n",
        "budgetTokens": 0
      },
      "rewrite-prompt": {
        "id": "rewrite-prompt",
        "type": "workflow",
        "operation": "text-rules",
        "operationVersion": 1,
        "title": "Text Rules",
        "enabled": true,
        "x": 860,
        "y": 380,
        "w": 320,
        "h": 220,
        "inGroup": "prompt-rewriter-layer",
        "profileId": null,
        "model": "rewriter",
        "modelRole": "rewriter",
        "alias": "Prompt Rewriter · 2.5D Orthographic Matte",
        "inputKind": "text",
        "mode": "replace",
        "rules": [
          {
            "match": "^Subject: (.*)",
            "replace": "orthographic top-down 2.5D isometric game asset cutout, $1"
          }
        ],
        "separator": "\n",
        "scope": "authorized",
        "protectedLiterals": []
      },
      "format-flux3-conditioning": {
        "id": "format-flux3-conditioning",
        "type": "workflow",
        "operation": "compose",
        "operationVersion": 1,
