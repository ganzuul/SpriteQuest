        "modelRole": "rewriter",
        "alias": "Prompt Rewriter · 2.5D Orthographic Matte",
        "inputKind": "text",
        "mode": "replace",
        "rules": [
          {
            "kind": "regex",
            "pattern": "^Subject: (.*)",
            "replacement": "orthographic top-down 2.5D isometric game asset cutout, $1",
