{
  "name": "lattice",
  "version": "0.24.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "node tools/test-all.mjs",
    "test:browser": "playwright test",
    "harness": "node tools/serve-harness.mjs",
    "build": "vite build",
    "check:types": "svelte-check --tsconfig ./tsconfig.json",
    "check:assets": "node tools/check-assets.mjs",
    "check": "npm run test && npm run check:types && npm run build && npm run check:assets && npm run test:browser",
    "benchmark": "node tools/benchmark-canvas.mjs",
    "capture": "node tools/capture-workbench.mjs",
    "smoke:install": "node tools/smoke-install.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@sveltejs/vite-plugin-svelte": "7.3.0",
    "@types/node": "26.4.0",
    "jsdom": "30.0.1",
    "svelte": "5.56.10",
    "svelte-check": "4.7.6",
    "typescript": "6.0.2",
    "vite": "8.2.2"
  }
}
